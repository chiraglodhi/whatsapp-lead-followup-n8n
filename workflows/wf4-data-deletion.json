  "name": "WF4 — Data Deletion",
  "nodes": [
    {
      "parameters": {
        "content": "## WF4 data deletion\nAdmin tool. Keep UNPUBLISHED: run from the editor. Requires typed DELETE. Covers Supabase only (Twilio logs, n8n execution history and Slack history are not cleared). Slack gets only the last 4 phone digits.",
        "height": 144,
        "width": 400,
        "color": "#0D2B20"
      },
      "name": "Sticky Note 4a000041",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-208, -128]
    },
    {
      "parameters": {
        "formTitle": "Delete a lead (WF4)",
        "formDescription": "Permanently deletes the lead with this phone number, plus all their messages and qualification data. Cannot be undone.",
        "formFields": {
          "values": [
            { "fieldLabel": "Lead phone number", "fieldName": "phone", "placeholder": "+919876543210", "requiredField": true },
            { "fieldLabel": "Type DELETE to confirm", "fieldName": "confirm", "placeholder": "DELETE", "requiredField": true }
          ]
        },
        "options": { "appendAttribution": false }
      },
      "name": "Deletion request form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [0, 288]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\n// Same normalisation as WF1 (India-only prototype)\nlet phone = String(raw.phone || '').replace(/[\\s\\-\\(\\)]/g, '');\nif (phone.startsWith('0')) phone = '+91' + phone.slice(1);\nelse if (phone && !phone.startsWith('+')) phone = '+91' + phone;\nconst phoneOk = /^\\+91\\d{10}$/.test(phone);\nconst confirmOk = String(raw.confirm || '').trim() === 'DELETE';\nlet reason = null;\nif (!phoneOk) reason = 'Invalid phone format. Nothing was deleted.';\nelse if (!confirmOk) reason = 'Confirmation text must be exactly DELETE. Nothing was deleted.';\nreturn [{ json: { valid: phoneOk && confirmOk, phone, reason } }];"
      },
      "name": "Validate input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [224, 288]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3 },
          "conditions": [
            { "leftValue": "={{ $json.valid }}", "operator": { "type": "boolean", "operation": "true", "singleValue": true } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Input valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [448, 288]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "leads",
        "limit": 1,
        "matchType": "allFilters",
        "filters": { "conditions": [ { "keyName": "phone", "condition": "eq", "keyValue": "={{ $json.phone }}" } ] }
      },
      "name": "Find lead by phone",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [672, 192],
      "alwaysOutputData": true,
      "credentials": { "supabaseApi": { "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID", "name": "Supabase - lead-followup" } }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3 },
          "conditions": [
            { "leftValue": "={{ $json.id }}", "operator": { "type": "string", "operation": "exists", "singleValue": true } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Lead found?",
