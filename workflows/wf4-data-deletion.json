        "filters": { "conditions": [ { "keyName": "id", "condition": "eq", "keyValue": "={{ $(\"Find lead by phone\").first().json.id }}" } ] }
      },
      "name": "Delete lead (cascade)",
      "type": "n8n-nodes-base.supabase",
