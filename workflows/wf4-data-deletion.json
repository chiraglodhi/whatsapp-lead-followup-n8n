      "onError": "continueErrorOutput",
      "credentials": { "supabaseApi": { "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID", "name": "Supabase - lead-followup" } }
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": { "__rl": true, "value": "#lead-alerts", "mode": "name" },
        "text": "=🗑️ DATA DELETED\nLead: phone ending {{ $(\"Validate input\").first().json.phone.slice(-4) }} (name not logged here on purpose)\nWorkflow: WF4\nDetails: lead row deleted; {{ $(\"Count messages\").all().filter(i => i.json.id).length }} messages removed by cascade, qualification removed by cascade\nTime: {{ $now.toISO() }}\nAction needed: none. If a data-deletion request prompted this, also clear Twilio logs and n8n execution history manually.",
        "otherOptions": { "includeLinkToWorkflow": false }
