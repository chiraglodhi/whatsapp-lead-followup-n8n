        "returnAll": true,
        "matchType": "allFilters",
        "filters": { "conditions": [ { "keyName": "lead_id", "condition": "eq", "keyValue": "={{ $(\"Find lead by phone\").first().json.id }}" } ] }
      },
      "name": "Count messages",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1120, 96],
      "alwaysOutputData": true,
      "credentials": { "supabaseApi": { "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID", "name": "Supabase - lead-followup" } }
    },
