{
  "name": "WF1 - Lead Intake",
  "nodes": [
    {
      "parameters": {
        "jsCode": "// Code node → JavaScript\n// ASSUMPTION — verify field names (name, phone, consent, preferred_language) in the form trigger's Output panel\nconst raw = $input.first().json;\nlet phone = (raw.phone || '').replace(/[\\s\\-\\(\\)]/g, '');\n\nif (phone.startsWith('0')) phone = '+91' + phone.slice(1);\nelse if (!phone.startsWith('+')) phone = '+91' + phone;\n\nconst valid = /^\\+91\\d{10}$/.test(phone);\nconst consent = raw.consent === true || raw.consent === 'true' || raw.consent === 'yes';\nconst lang = ['hi', 'en'].includes(raw.preferred_language) ? raw.preferred_language : 'bilingual';\n\nreturn [{\n  json: {\n    phone,\n    name: (raw.name || '').trim(),\n    source: 'form',\n    preferred_language: lang,\n    consent,\n    valid_phone: valid,\n    raw_payload: raw\n  }\n}];"
      },
      "name": "Normalize lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-992, -912]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3 },
          "conditions": [
            { "leftValue": "={{ $json.valid_phone }}", "operator": { "type": "boolean", "operation": "true", "singleValue": true } },
            { "leftValue": "={{ $json.consent }}", "operator": { "type": "boolean", "operation": "true", "singleValue": true } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Valid phone?",
