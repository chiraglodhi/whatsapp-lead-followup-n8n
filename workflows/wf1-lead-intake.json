    {
      "parameters": {
        "jsCode": "// Code node → JavaScript\n// Reads from Normalize lead explicitly so it doesn't depend on what Insert lead returns\nconst lead = $('Normalize lead').first().json;\nconst lang = lead.preferred_language;\nconst name = lead.name || '';\n\nconst openers = {\n  hi: `नमस्ते ${name}! 🏠 आपने रियल एस्टेट में रुचि दिखाई है। मैं आपकी ज़रूरतें समझने में मदद करूँगा।\\n\\nइस चैट को बंद करने के लिए UNSUBSCRIBE लिखें।`,\n  en: `Hi ${name}! 🏠 Thanks for your interest in real estate. I'll help understand what you're looking for.\\n\\nType UNSUBSCRIBE to stop receiving messages.`,\n  bilingual: `नमस्ते ${name}! 🏠 Hi! आपने रियल एस्टेट में रुचि दिखाई है। Thanks for your interest!\\n\\nमैं आपकी ज़रूरतें समझने में मदद करूँगा। I'll help understand what you're looking for.\\n\\nType UNSUBSCRIBE / UNSUBSCRIBE लिखें to stop.`\n};\n\nreturn [{\n  json: {\n    lead_id: $('Insert lead').first().json.id, \n    phone: lead.phone,\n    opener_text: openers[lang] || openers.bilingual\n  }\n}];"
      },
