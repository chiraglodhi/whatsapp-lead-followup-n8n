# Nothing in this file is read by the workflows. n8n stores credentials in its own credential
# store; this file lists what you must create there. Never commit real values.

# --- n8n credential: "Supabase - lead-followup" (type: Supabase API) ---
SUPABASE_HOST=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # service_role key (RLS is on with no policies, so anon will not work)

# --- n8n credential: "Twilio - WhatsApp Sandbox" (type: Twilio API) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=                    # also needed as an n8n VARIABLE, see below

# --- n8n VARIABLE named TWILIO_AUTH_TOKEN (Variables page in n8n) ---
# WF2 reads it as $vars.TWILIO_AUTH_TOKEN to verify the X-Twilio-Signature header.
# Same value as TWILIO_AUTH_TOKEN above. If you rotate the token, update both places.

# --- n8n credential: "OpenAI account" (type: OpenAI API) ---
OPENAI_API_KEY=

# --- n8n credential: "Slack - Lead Alerts Bot" (type: Slack API) ---
SLACK_BOT_TOKEN=                      # xoxb-... ; needs permission to post in the alerts channel
SLACK_ALERT_CHANNEL=#lead-alerts      # workflows reference the channel by name or by ID

# --- Constants hard-coded in the workflows (edit in the nodes if yours differ) ---
# Twilio WhatsApp sandbox sender: +14155238886  (shared public sandbox number)
# Model: gpt-4o-mini
